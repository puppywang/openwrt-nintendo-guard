#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/nintendo-guard serve
	procd_set_param env GOMEMLIMIT=32MiB GOGC=50
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/nintendo-control.json
	procd_close_instance
}

# Intentionally retain protection when stopped or while procd restarts it.
# To disable protection, select Off in LuCI before disabling the service.
reload_service() {
	/usr/sbin/nintendo-guard firewall
}

service_triggers() {
	procd_add_reload_trigger firewall
}
